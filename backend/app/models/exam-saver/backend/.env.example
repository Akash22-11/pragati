# Port the Express server listens on
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/exam_saver
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/exam_saver
MONGO_URI=mongodb://127.0.0.1:27017/exam_saver

# Comma-separated list of allowed frontend origins (for CORS)
CLIENT_ORIGIN=http://localhost:5173
